{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seeon.example/contracts/model-selection.schema.json",
  "title": "Desired model selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_publication",
    "runtime_format",
    "transition_threshold",
    "threshold_source"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "model_publication": {
      "$ref": "#/$defs/modelPublication"
    },
    "runtime_format": {
      "type": "string",
      "minLength": 1
    },
    "transition_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold_source": {
      "enum": [
        "default",
        "receipt"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_locator",
        "revision",
        "bundle_sha256"
      ],
      "properties": {
        "source_locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
